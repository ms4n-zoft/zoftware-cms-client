---
import LandingExperience from "../../components/LandingExperience";
import TenantConfigScript from "../../components/TenantConfigScript.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import type { CatalogProduct } from "../../lib/catalog";
import {
  getDefaultPartnerSlug,
  getParentCategories,
  getProductsByParentCategory,
  getTenantConfig,
} from "../../lib/clientApi";

const partnerSlug = Astro.params.partner ?? getDefaultPartnerSlug();
const tenantConfig = await getTenantConfig(partnerSlug);

if (!tenantConfig) {
  return Astro.redirect("/");
}

const categories = (await getParentCategories(partnerSlug)) ?? [];
const productResults = await Promise.all(
  categories.map((category) =>
    getProductsByParentCategory(partnerSlug, category.weburl, {
      limit: 6,
      sortBy: "rating",
    }).catch(() => null),
  ),
);
const featuredProducts = uniqueProducts(
  productResults.flatMap((result) => result?.products ?? []),
).slice(0, 18);

function uniqueProducts(products: CatalogProduct[]) {
  const seen = new Set<string>();

  return products.filter((product) => {
    if (seen.has(product.weburl)) {
      return false;
    }

    seen.add(product.weburl);
    return true;
  });
}
---

<BaseLayout
  title={`${tenantConfig.name} Software Discovery`}
  description={`Browse ${tenantConfig.name} software categories, products, and recommendations.`}
  useActiveTheme={true}
  themeId={tenantConfig.themeId}
>
  <TenantConfigScript partnerSlug={partnerSlug} tenantConfig={tenantConfig} />
  <LandingExperience
    client:load
    partnerSlug={partnerSlug}
    parentCategories={categories}
    featuredProducts={featuredProducts}
  />
</BaseLayout>
