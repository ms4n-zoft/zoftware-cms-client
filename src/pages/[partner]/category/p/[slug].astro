---
import CatalogProductCard from "../../../../components/CatalogProductCard.astro";
import CatalogShell from "../../../../components/CatalogShell.astro";
import ThemeBreadcrumbs from "../../../../components/theme-system/ThemeBreadcrumbs.astro";
import ThemePageFrame from "../../../../components/theme-system/ThemePageFrame.astro";
import ThemePageHeader from "../../../../components/theme-system/ThemePageHeader.astro";
import ThemePanel from "../../../../components/theme-system/ThemePanel.astro";
import ThemeSection from "../../../../components/theme-system/ThemeSection.astro";
import ThemeSplitLayout from "../../../../components/theme-system/ThemeSplitLayout.astro";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { formatNumber } from "../../../../lib/catalog";
import {
  getDefaultPartnerSlug,
  getParentCategory,
  getParentSubcategories,
  getProductsByParentCategory,
  getTenantConfig,
} from "../../../../lib/clientApi";

const partnerSlug = Astro.params.partner ?? getDefaultPartnerSlug();
const categorySlug = Astro.params.slug ?? "";
const tenantConfig = await getTenantConfig(partnerSlug);

if (!tenantConfig) {
  return Astro.redirect("/");
}

const [category, subcategoryResult, productResult] = await Promise.all([
  getParentCategory(partnerSlug, categorySlug),
  getParentSubcategories(partnerSlug, categorySlug),
  getProductsByParentCategory(partnerSlug, categorySlug, { limit: 8 }),
]);

if (!category) {
  return Astro.redirect(`/${partnerSlug}`);
}

const subcategories = subcategoryResult?.subCategories ?? [];
const featuredProducts = productResult?.products ?? [];
const description = category.description || category.meta_description || "";
---

<BaseLayout
  title={`${category.name} Software Categories`}
  description={description}
  useActiveTheme={true}
  themeId={tenantConfig.themeId}
>
  <CatalogShell partnerSlug={partnerSlug} tenantConfig={tenantConfig}>
    <ThemePageFrame>
      <ThemeSplitLayout>
        <ThemeBreadcrumbs
          items={[
            { label: "Home", href: `/${partnerSlug}` },
            { label: category.name },
          ]}
        />

        <ThemePageHeader
          eyebrow="Category overview"
          title={category.name}
          description={description}
        />

        <ThemePanel variant="hero" bodyClass="catalog-overview">
          <h2>What is {category.name}</h2>
          <p>
            <strong>{category.name} software</strong> {description}
            These tools help teams evaluate options, compare capabilities, and shortlist products with more confidence.
          </p>
          <button type="button">See More</button>
        </ThemePanel>

        <ThemeSection
          id="popular-subcategories"
          title={`Popular ${category.name} Categories`}
          description="Browse the most active buying intents and subcategory groupings."
          actionHref={`/${partnerSlug}`}
          actionLabel="All categories"
        >
          <div class="subcategory-grid">
            {subcategories.map((subcategory) => (
              <a class="subcategory-tile" href={`/${partnerSlug}/category/${subcategory.weburl}`}>
                <span>
                  <strong>{subcategory.name}</strong>
                  <small>{subcategory.description || subcategory.meta_description}</small>
                </span>
                <i>›</i>
              </a>
            ))}
          </div>
        </ThemeSection>

        <ThemeSection
          title={`Best products used by ${category.name} professionals`}
          description="Shortlisted products that map cleanly to this category."
          actionHref={
            subcategories[0]
              ? `/${partnerSlug}/category/${subcategories[0].weburl}`
              : `/${partnerSlug}`
          }
          actionLabel="View All"
        >
          <div class="catalog-product-list catalog-product-list--compact">
            {featuredProducts.map((product) => (
              <CatalogProductCard product={product} partnerSlug={partnerSlug} />
            ))}
          </div>
        </ThemeSection>

        <ThemePanel slot="aside" tag="section" class="metric-card" padded={false}>
          <p>Available Products</p>
          <strong>{formatNumber(productResult?.pagination.total)}</strong>
          <p>Available Subcategories</p>
          <strong>{formatNumber(subcategories.length)}</strong>
        </ThemePanel>

        <ThemePanel slot="aside" tag="section" class="sidebar-list" padded={false}>
          <h2>{category.name}</h2>
          {subcategories.map((subcategory) => (
            <a href={`/${partnerSlug}/category/${subcategory.weburl}`}>
              {subcategory.name}
              <span>›</span>
            </a>
          ))}
        </ThemePanel>
      </ThemeSplitLayout>
    </ThemePageFrame>
  </CatalogShell>
</BaseLayout>
