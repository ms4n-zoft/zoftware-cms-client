---
import PublicThemeFooter from "./PublicThemeFooter";
import PublicThemeHeader from "./PublicThemeHeader";
import TenantConfigScript from "./TenantConfigScript.astro";
import type { TenantClientConfig } from "../lib/clientApi";

type Props = {
  partnerSlug?: string;
  tenantConfig?: TenantClientConfig | null;
};

const { partnerSlug = "", tenantConfig = null } = Astro.props;
---

<TenantConfigScript partnerSlug={partnerSlug} tenantConfig={tenantConfig} />
<PublicThemeHeader client:load partnerSlug={partnerSlug} />
<slot />
<PublicThemeFooter client:load partnerSlug={partnerSlug} />
